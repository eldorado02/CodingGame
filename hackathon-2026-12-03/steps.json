    "role": "code",
    "prompt": "phase1_dsa.md",
    "handoff": "dsa/HANDOFF-dsa.md",
    "artifacts": [
      "dsa/README.md",
      "dsa/C/dsa.h",
      "dsa/CPP/dsa.hpp",
      "dsa/Rust/src/lib.rs",
      "dsa/Python/dsa.py"
    ],
    "next": "phase2.index"
  },
  "phase2.index": {
    "role": "deep_search",
    "prompt": "phase2_index.md",
