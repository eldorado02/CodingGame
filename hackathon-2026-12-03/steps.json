      "challenges/<id>/critique.md",
      "challenges/<id>/solutions/",
      "challenges/<id>/tests/"
    ],
    "next": "phase2.challenge",
    "sequence": "challenges.json ordre chronologique, un seul challenge à la fois",
    "completed": ["2016-smash-the-code", "2016-codebusters", "2016-hypersonic", "2016-fantastic-bits", "2017-ghost-in-the-cell", "2017-coders-of-the-caribbean", "2017-wondev-woman", "2017-mean-max", "2018-botters-of-the-galaxy", "2018-code-royale", "2018-code-of-kutulu", "2018-a-star-craft", "2018-xmas-rush", "2019-code-a-la-mode", "2019-a-code-of-ice-and-fire", "2020-ocean-of-code", "2020-spring-challenge", "2020-fall-challenge", "2021-spring-challenge"]
  }
